# Production environment for office.k2softwarestudio.com
# Copy to your server environment configuration and replace secret values.
APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=Asia/Yangon

DB_HOST=127.0.0.1
DB_NAME=ksspm
DB_USER=ksspm_app
DB_PASS=REPLACE_WITH_DATABASE_PASSWORD
DB_TIMEZONE=+06:30

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_TTL_SECONDS=28800
JWT_REMEMBER_TTL_SECONDS=2592000
CORS_ORIGIN=https://office.k2softwarestudio.com

# Use auto to discover <deployment-directory>/backend automatically.
VITE_API_BASE_URL=auto
